{
  "manifest_version": 3,
  "name": "GTM Maps - Lead Collector",
  "version": "1.0.0",
  "description": "Add companies and LinkedIn profiles directly to GTM Maps.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*", "https://www.linkedin.com/company/*"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["*://*.run.app/*"]
}
